---
import '../styles/global.css';
import { SITE } from '../config.js';

const { title, description, jsonLd = [], noindex = false, lang = 'en' } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '').replace(/\/index$/, '');
const canonical = `${SITE.url}${path || '/'}`;
// The home tool page has country versions. Each one lists all of them, itself included.
const REGIONS = { '': ['en', 'x-default'], '/en-ca': ['en-CA'], '/en-au': ['en-AU'] };
const alternates = path in REGIONS ? Object.entries(REGIONS).flatMap(([p, codes]) => codes.map((code) => [code, `${SITE.url}${p || '/'}`])) : [];
const ogImage = `${SITE.url}/og.png`;
const graphs = Array.isArray(jsonLd) ? [...jsonLd] : [jsonLd];
// The home page tells search engines who publishes the site.
if (!path) {
  graphs.push(
    { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: `${SITE.url}/` },
    { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: `${SITE.url}/`, logo: `${SITE.url}/favicon.svg`, email: SITE.contactEmail, founder: { '@type': 'Person', name: SITE.editor, sameAs: Object.values(SITE.editorLinks) } }
  );
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map(([code, href]) => <link rel="alternate" hreflang={code} href={href} />)}
    {noindex && <meta name="robots" content="noindex" />}
    {SITE.adsenseClient && <meta name="google-adsense-account" content={SITE.adsenseClient} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {graphs.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="wordmark" href="/">{SITE.name}</a>
        <nav class="site-nav" aria-label="Main">
          <a href="/tools" aria-current={path === '/tools' ? 'page' : undefined}>Tools</a>
          <a href="/guides" aria-current={path.startsWith('/guides') ? 'page' : undefined}>Guides</a>
          <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div>
          <h2>Guides</h2>
          <ul>
            <li><a href="/guides/how-to-humanize-ai-text">How to humanize AI text</a></li>
            <li><a href="/guides/ai-phrases-to-avoid">AI phrases to avoid</a></li>
            <li><a href="/guides/chatgpt-em-dash">ChatGPT and the em dash</a></li>
            <li><a href="/guides/prompts-to-make-chatgpt-sound-human">Prompts for natural writing</a></li>
            <li><a href="/guides/ai-draft-editing-checklist">Editing checklist</a></li>
            <li><a href="/guides">All guides</a></li>
          </ul>
        </div>
        <div>
          <h2>Tools</h2>
          <ul>
            <li><a href="/">AI text humanizer</a></li>
            <li><a href="/humanize-chatgpt-text">ChatGPT text humanizer</a></li>
            <li><a href="/en-ca">Canadian English humanizer</a></li>
            <li><a href="/en-au">Australian English humanizer</a></li>
            <li><a href="/ai-email-editor">Email editor</a></li>
            <li><a href="/ai-blog-post-editor">Blog post editor</a></li>
            <li><a href="/linkedin-post-editor">LinkedIn post editor</a></li>
            <li><a href="/cover-letter-editor">Cover letter editor</a></li>
            <li><a href="/ai-essay-editor">Essay editor</a></li>
            <li><a href="/ai-phrase-checker">AI phrase checker</a></li>
            <li><a href="/readability-checker">Readability checker</a></li>
            <li><a href="/word-counter">Word counter</a></li>
          </ul>
        </div>
        <div>
          <h2>About</h2>
          <ul>
            <li><a href="/how-it-works">How it works</a></li>
            <li><a href="/faq">FAQ</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/editorial-policy">Editorial policy</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <h2>Legal</h2>
          <ul>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
          </ul>
        </div>
      </div>
      <p class="footer-note">
        Use AI in line with your school's or employer's rules. You are responsible for what you submit or publish. © 2026 {SITE.name}.
      </p>
    </footer>
    {SITE.adsenseClient && <script src="/ads-loader.js" data-client={SITE.adsenseClient} defer></script>}
  </body>
</html>
